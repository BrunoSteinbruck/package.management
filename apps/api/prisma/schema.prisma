generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * SEM USO no código: `Condominio.plano` só é escrito pelos seeds e nunca é
 * lido. Não existe billing do SaaS, e o que hoje liga ou desliga funcionalidade
 * é `Condominio.modulos`, não o plano. Fica como registro comercial do que foi
 * precificado; quem for implementar cobrança do produto começa por aqui.
 */
enum Plano {
  ESSENCIAL
  PROFISSIONAL
  ENTERPRISE
}

enum PapelUsuario {
  PORTEIRO
  APOIO
  SINDICO
  ADMIN
}

enum StatusPacote {
  ARMAZENADO
  ENTREGUE
  EXTRAVIADO
}

enum StatusVinculo {
  PENDENTE
  ATIVO
  REMOVIDO
}

enum CanalNotificacao {
  PUSH
  WHATSAPP
  // SEM USO: nenhum caminho grava SMS nesta tabela. O tipo local do worker é
  // literalmente `"PUSH" | "WHATSAPP"`. O SMS que o produto envia (código de
  // acesso e convite de adoção) não vira linha de Notificacao: o convite é
  // registrado em Convite.canal, que é outro enum. Fica porque tirar valor de
  // enum no Postgres exige recriar o tipo; se um dia o SMS entrar na fila de
  // notificação, o valor já está aqui.
  SMS
}

enum TipoNotificacao {
  ENTRADA
  RETIRADA
  CONVITE
  LEMBRETE
  AVISO // Via 2: status do relato mudou, avisa o morador que o abriu
  OCORRENCIA
  OCORRENCIA_NOVA // Via 2: relato novo, avisa a administração
  COMUNICADO // Síndico publicou para o condomínio (ou para blocos)
  VISITA_CHEGOU // A portaria deu baixa na visita pré-autorizada
  COBRANCA_GERADA // Boleto da competência disponível
  COBRANCA_LEMBRETE // Vence em 3 dias
  COBRANCA_VENCIDA // Venceu ontem
  COBRANCA_PAGA // Recibo: o provedor confirmou a liquidação
}

enum StatusCobranca {
  PENDENTE
  PAGA
  VENCIDA
  CANCELADA
}

enum StatusVisita {
  AUTORIZADA
  CHEGOU
  CANCELADA
}

enum CategoriaDocumento {
  ATA
  REGIMENTO
  CONVENCAO
  OUTRO
}

enum ViaAviso {
  DIRECIONADO // equipe → morador (Via 1)
  OCORRENCIA // morador → administração (Via 2)
}

enum StatusAviso {
  ABERTO
  RESOLVIDO
}

enum StatusNotificacao {
  FILA
  ENVIADA
  ENTREGUE
  FALHA
}

enum Plataforma {
  IOS
  ANDROID
}

enum CanalConvite {
  SMS
  // SEM USO: nenhum código emite convite por cartaz ou pela portaria. Eram as
  // ideias de adoção que perderam para o SMS automático na entrada de
  // encomenda. Mantidos pelo mesmo motivo de CanalNotificacao.SMS.
  POSTER
  PORTARIA
  MORADOR
}

enum TipoMedidor {
  AGUA
  GAS
}

model Condominio {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String
  slug     String   @unique
  timezone String   @default("America/Sao_Paulo")
  plano    Plano    @default(ESSENCIAL)
  // Módulos opcionais ligados neste condomínio (vocabulário em
  // MODULOS_CONDOMINIO, no shared). Texto livre no banco em vez de enum
  // Postgres: a lista muda a cada módulo novo, e migração aditiva de array de
  // texto não trava deploy com app publicado.
  modulos  String[] @default([])
  criadoEm DateTime @default(now()) @map("criado_em")

  unidades     Unidade[]
  usuarios     Usuario[]
  pacotes      Pacote[]
  convites     Convite[]
  notificacoes Notificacao[]
  vagas        Vaga[]
  veiculos     Veiculo[]
  avisos       Aviso[]
  leituras     LeituraMedidor[]
  tarifas      TarifaConsumo[]
  comunicados  Comunicado[]
  documentos   Documento[]
  despesas     Despesa[]
  extratoItens ExtratoItem[]
  visitas      Visita[]
  cobrancas    Cobranca[]
  taxas        TaxaUnidade[]
  integracao   IntegracaoFinanceira?
  configFinanceiro ConfigFinanceiro?

  @@map("condominios")
}

model Unidade {
  id            String  @id @default(uuid()) @db.Uuid
  condominioId  String  @map("condominio_id") @db.Uuid
  bloco         String?
  identificacao String

  condominio Condominio @relation(fields: [condominioId], references: [id])
  vinculos   Vinculo[]
  pacotes    Pacote[]
  convites   Convite[]
  vagas      Vaga[]
  veiculos   Veiculo[]
  avisos     Aviso[]
  leituras   LeituraMedidor[]
  visitas    Visita[]
  cobrancas  Cobranca[]
  taxa       TaxaUnidade?

  @@unique([condominioId, bloco, identificacao])
  @@index([condominioId])
  @@map("unidades")
}

model Morador {
  id       String   @id @default(uuid()) @db.Uuid
  nome     String
  telefone String   @unique
  // Opt-in de WhatsApp (LGPD): consentimento é ato positivo, então o padrão
  // é false e quem liga é o morador, no app. Só vale para quem NÃO tem o
  // app instalado no aparelho em uso; com app, o canal é o push.
  aceitaWhatsapp Boolean @default(false) @map("aceita_whatsapp")
  criadoEm DateTime @default(now()) @map("criado_em")

  vinculos           Vinculo[]
  devices            Device[]
  avisosReportados   Aviso[]             @relation("avisoCriadoPorMorador")
  comunicadosLidos   ComunicadoLeitura[]
  retiradasRecebidas Retirada[]          @relation("retiradaRecebidaPor")
  visitasAutorizadas Visita[]

  @@map("moradores")
}

model Vinculo {
  id                  String        @id @default(uuid()) @db.Uuid
  moradorId           String        @map("morador_id") @db.Uuid
  unidadeId           String        @map("unidade_id") @db.Uuid
  // Denormalizado da unidade (imutável): permite descobrir o tenant a partir
  // do vínculo global antes de abrir a transação com RLS.
  condominioId        String        @map("condominio_id") @db.Uuid
  status              StatusVinculo @default(PENDENTE)
  // SEM USO: era o gancho para "preferências de notificação por morador", que
  // acabou nascendo em outro lugar (Morador.aceitaWhatsapp, por pessoa e não
  // por vínculo, porque o opt-in de LGPD é da pessoa). Nada lê nem escreve.
  contatoPreferencial Boolean       @default(false) @map("contato_preferencial")
  aprovadoPorId       String?       @map("aprovado_por_id") @db.Uuid
  criadoEm            DateTime      @default(now()) @map("criado_em")

  morador     Morador  @relation(fields: [moradorId], references: [id])
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  aprovadoPor Usuario? @relation(fields: [aprovadoPorId], references: [id])

  @@unique([moradorId, unidadeId])
  @@index([unidadeId])
  @@index([condominioId])
  @@map("vinculos")
}

model Usuario {
  id           String       @id @default(uuid()) @db.Uuid
  condominioId String       @map("condominio_id") @db.Uuid
  nome         String
  telefone     String       @unique
  papel        PapelUsuario
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now()) @map("criado_em")

  condominio         Condominio @relation(fields: [condominioId], references: [id])
  pacotesRecebidos   Pacote[]   @relation("recebidoPor")
  retiradasEntregues Retirada[]       @relation("entreguePor")
  vinculosAprovados  Vinculo[]
  avisosCriados      Aviso[]          @relation("avisoCriadoPorUsuario")
  devices            Device[]
  leiturasFeitas     LeituraMedidor[]
  comunicadosCriados Comunicado[]
  documentosEnviados Documento[]
  despesasCriadas    Despesa[]
  visitasConferidas  Visita[]

  @@index([condominioId])
  @@map("usuarios")
}

model Pacote {
  id                 String       @id @default(uuid()) @db.Uuid
  condominioId       String       @map("condominio_id") @db.Uuid
  unidadeId          String       @map("unidade_id") @db.Uuid
  transportadora     String?
  codigoRastreio     String?      @map("codigo_rastreio")
  notaFiscal         String?      @map("nota_fiscal")
  fotoEntradaKey     String?      @map("foto_entrada_key")
  localArmazenamento String?      @map("local_armazenamento")
  status             StatusPacote @default(ARMAZENADO)
  recebidoPorId      String       @map("recebido_por_id") @db.Uuid
  recebidoEm         DateTime     @default(now()) @map("recebido_em")

  condominio   Condominio    @relation(fields: [condominioId], references: [id])
  unidade      Unidade       @relation(fields: [unidadeId], references: [id])
  recebidoPor  Usuario       @relation("recebidoPor", fields: [recebidoPorId], references: [id])
  retirada     Retirada?
  notificacoes Notificacao[]

  @@index([condominioId, status])
  @@index([unidadeId, status])
  @@map("pacotes")
}

model Retirada {
  id            String   @id @default(uuid()) @db.Uuid
  condominioId  String   @map("condominio_id") @db.Uuid
  pacoteId      String   @unique @map("pacote_id") @db.Uuid
  entreguePorId String   @map("entregue_por_id") @db.Uuid
  fotoSaidaKey  String?  @map("foto_saida_key")
  // Quem RECEBEU. Até aqui a retirada só registrava quem entregou (o
  // porteiro) e a foto: o pacote saía sem constar para quem foi. O QR não
  // resolvia isso, porque resolvia a UNIDADE e não a pessoa.
  //
  // Dois campos porque quem retira nem sempre é morador: quando é, fica a FK
  // (nome atual vem da tabela, e acompanha quem mudou de nome); quando é
  // faxineira, filho ou motoboy, fica só o texto que o porteiro escreveu.
  // Nome de terceiro é dado pessoal de quem não consentiu: campo opcional,
  // curto e sem documento, no mesmo critério do visitante.
  recebidoPorMoradorId String? @map("recebido_por_morador_id") @db.Uuid
  recebidoPorNome      String? @map("recebido_por_nome")
  retiradoEm    DateTime @default(now()) @map("retirado_em")

  pacote          Pacote   @relation(fields: [pacoteId], references: [id])
  entreguePor     Usuario  @relation("entreguePor", fields: [entreguePorId], references: [id])
  recebidoPor     Morador? @relation("retiradaRecebidaPor", fields: [recebidoPorMoradorId], references: [id])

  @@index([condominioId])
  @@map("retiradas")
}

model Notificacao {
  id            String            @id @default(uuid()) @db.Uuid
  condominioId  String            @map("condominio_id") @db.Uuid
  pacoteId      String?           @map("pacote_id") @db.Uuid
  avisoId       String?           @map("aviso_id") @db.Uuid
  comunicadoId  String?           @map("comunicado_id") @db.Uuid
  visitaId      String?           @map("visita_id") @db.Uuid
  cobrancaId    String?           @map("cobranca_id") @db.Uuid
  canal         CanalNotificacao
  tipo          TipoNotificacao
  status        StatusNotificacao @default(FILA)
  providerMsgId String?           @map("provider_msg_id")
  criadoEm      DateTime          @default(now()) @map("criado_em")

  condominio Condominio  @relation(fields: [condominioId], references: [id])
  pacote     Pacote?     @relation(fields: [pacoteId], references: [id])
  aviso      Aviso?      @relation(fields: [avisoId], references: [id])
  comunicado Comunicado? @relation(fields: [comunicadoId], references: [id])
  visita     Visita?     @relation(fields: [visitaId], references: [id])
  cobranca   Cobranca?   @relation(fields: [cobrancaId], references: [id])

  @@index([condominioId, status])
  @@map("notificacoes")
}

model Convite {
  id           String       @id @default(uuid()) @db.Uuid
  condominioId String       @map("condominio_id") @db.Uuid
  unidadeId    String?      @map("unidade_id") @db.Uuid
  codigo       String       @unique
  canal        CanalConvite
  expiraEm     DateTime     @map("expira_em")
  usadoEm      DateTime?    @map("usado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade?   @relation(fields: [unidadeId], references: [id])

  @@map("convites")
}

model Device {
  id String @id @default(uuid()) @db.Uuid
  // Exatamente um dono: morador ou membro da equipe. O CHECK que garante isso
  // vive na migração, porque o Prisma não modela a restrição. Enquanto o dono
  // só podia ser morador, não havia caminho físico para notificar um síndico.
  moradorId  String?    @map("morador_id") @db.Uuid
  usuarioId  String?    @map("usuario_id") @db.Uuid
  pushToken  String     @unique @map("push_token")
  plataforma Plataforma
  ultimoUso  DateTime   @default(now()) @map("ultimo_uso")

  morador Morador? @relation(fields: [moradorId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@map("devices")
}

model OtpChallenge {
  id         String   @id @default(uuid()) @db.Uuid
  telefone   String   @unique
  codigoHash String   @map("codigo_hash")
  expiraEm   DateTime @map("expira_em")
  tentativas Int      @default(0)
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@map("otp_challenges")
}

// Vaga de garagem ligada a uma unidade: resolve o dono na Via 1.
model Vaga {
  id            String @id @default(uuid()) @db.Uuid
  condominioId  String @map("condominio_id") @db.Uuid
  identificacao String
  unidadeId     String @map("unidade_id") @db.Uuid

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade    @relation(fields: [unidadeId], references: [id])

  @@unique([condominioId, identificacao])
  @@index([condominioId])
  @@map("vagas")
}

// Veículo do morador (placa normalizada UPPER sem hífen): resolve o dono
// por OCR de placa na Via 1.
model Veiculo {
  id           String  @id @default(uuid()) @db.Uuid
  condominioId String  @map("condominio_id") @db.Uuid
  placa        String
  modelo       String?
  cor          String?
  unidadeId    String  @map("unidade_id") @db.Uuid

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade    @relation(fields: [unidadeId], references: [id])

  @@unique([condominioId, placa])
  @@index([condominioId])
  @@map("veiculos")
}

// Leitura mensal de um medidor (água ou gás) de uma unidade, com a foto como
// evidência. O consumo NUNCA é persistido: deriva no read comparando com a
// leitura anterior, então lançamento retroativo se corrige sozinho.
model LeituraMedidor {
  id           String      @id @default(uuid()) @db.Uuid
  condominioId String      @map("condominio_id") @db.Uuid
  unidadeId    String      @map("unidade_id") @db.Uuid
  tipo         TipoMedidor
  // Sempre o dia 1 do mês (UTC). Nas bordas da API trafega como "YYYY-MM".
  competencia  DateTime    @db.Date
  valor        Decimal     @db.Decimal(12, 3)
  fotoKey      String?     @map("foto_key")
  lidoPorId    String      @map("lido_por_id") @db.Uuid
  lidoEm       DateTime    @default(now()) @map("lido_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade    @relation(fields: [unidadeId], references: [id])
  lidoPor    Usuario    @relation(fields: [lidoPorId], references: [id])

  @@unique([unidadeId, tipo, competencia])
  @@index([condominioId, competencia])
  @@map("leituras_medidor")
}

// Tarifa vigente por m³ (uma linha por tipo). Sem histórico de tarifa no v1:
// o valor em R$ do painel usa sempre a tarifa atual.
model TarifaConsumo {
  id           String      @id @default(uuid()) @db.Uuid
  condominioId String      @map("condominio_id") @db.Uuid
  tipo         TipoMedidor
  valorPorM3   Decimal     @map("valor_por_m3") @db.Decimal(10, 2)
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@unique([condominioId, tipo])
  @@map("tarifas_consumo")
}

/**
 * Comunicado do síndico para o condomínio inteiro (ou para blocos).
 *
 * Tabela própria e não uma terceira `via` de Aviso: Aviso exige `unidadeId`,
 * e comunicado não tem unidade. Encaixá-lo lá obrigaria a criar uma linha por
 * unidade só para dizer a mesma coisa a todo mundo, o que multiplicaria o
 * mesmo texto por centenas de linhas e ainda misturaria com a Via 1 no painel.
 */
model Comunicado {
  id     String @id @default(uuid()) @db.Uuid
  condominioId String @map("condominio_id") @db.Uuid
  titulo String
  corpo  String
  // Vazio = condomínio inteiro. Com valores, só as unidades desses blocos.
  blocos String[] @default([])
  criadoPorUsuarioId String @map("criado_por_usuario_id") @db.Uuid
  criadoEm DateTime @default(now()) @map("criado_em")

  condominio   Condominio          @relation(fields: [condominioId], references: [id])
  criadoPor    Usuario             @relation(fields: [criadoPorUsuarioId], references: [id])
  leituras     ComunicadoLeitura[]
  notificacoes Notificacao[]

  @@index([condominioId, criadoEm])
  @@map("comunicados")
}

/**
 * Recibo de leitura: existe a linha, o morador leu. É o que responde a
 * pergunta que o síndico faz depois de todo comunicado ("quem viu?"), e a
 * razão de o comunicado não caber em Notificacao, que registra ENVIO.
 */
model ComunicadoLeitura {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  comunicadoId String   @map("comunicado_id") @db.Uuid
  moradorId    String   @map("morador_id") @db.Uuid
  lidoEm       DateTime @default(now()) @map("lido_em")

  comunicado Comunicado @relation(fields: [comunicadoId], references: [id])
  morador    Morador    @relation(fields: [moradorId], references: [id])

  @@unique([comunicadoId, moradorId])
  @@index([condominioId])
  @@map("comunicado_leituras")
}

/**
 * Ata, regimento ou convenção que o morador consulta pelo app.
 *
 * `removidoEm` em vez de DELETE: documento retirado do ar continua sendo o
 * que estava valendo na época, e o arquivo segue no storage para quem já
 * tinha o link. Some da lista, não da história.
 */
model Documento {
  id           String             @id @default(uuid()) @db.Uuid
  condominioId String             @map("condominio_id") @db.Uuid
  titulo       String
  categoria    CategoriaDocumento
  arquivoKey   String             @map("arquivo_key")
  tamanhoBytes Int                @map("tamanho_bytes")
  criadoPorUsuarioId String       @map("criado_por_usuario_id") @db.Uuid
  criadoEm     DateTime           @default(now()) @map("criado_em")
  removidoEm   DateTime?          @map("removido_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])
  criadoPor  Usuario    @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([condominioId, categoria])
  @@map("documentos")
}

/**
 * Visita pré-autorizada pelo morador, conferida pela portaria na chegada.
 *
 * O produto já é forte na portaria; isto fecha o outro lado do portão com a
 * mesma mecânica das encomendas: alguém chega, a equipe confirma numa tela, e
 * o morador é avisado na hora.
 *
 * `documento` é dado pessoal de TERCEIRO (a visita não é usuária do sistema e
 * não consentiu com nada): fica opcional, só a portaria e o gestor enxergam,
 * e a rotina de expurgo em `documentos-de-visita` apaga depois de 90 dias.
 */
model Visita {
  id           String       @id @default(uuid()) @db.Uuid
  condominioId String       @map("condominio_id") @db.Uuid
  unidadeId    String       @map("unidade_id") @db.Uuid
  // Quem autorizou. A visita pertence à unidade, mas o registro de quem
  // liberou a entrada é o que responde "quem deixou essa pessoa entrar?".
  moradorId    String       @map("morador_id") @db.Uuid
  nomeVisitante String      @map("nome_visitante")
  documento    String?
  // Data prevista (sem hora): a janela opcional é o intervalo do dia.
  dataPrevista DateTime     @map("data_prevista") @db.Date
  janelaInicio String?      @map("janela_inicio")
  janelaFim    String?      @map("janela_fim")
  status       StatusVisita @default(AUTORIZADA)
  chegadaEm    DateTime?    @map("chegada_em")
  baixaPorId   String?      @map("baixa_por_id") @db.Uuid
  criadoEm     DateTime     @default(now()) @map("criado_em")

  condominio   Condominio    @relation(fields: [condominioId], references: [id])
  unidade      Unidade       @relation(fields: [unidadeId], references: [id])
  morador      Morador       @relation(fields: [moradorId], references: [id])
  baixaPor     Usuario?      @relation(fields: [baixaPorId], references: [id])
  notificacoes Notificacao[]

  @@index([condominioId, dataPrevista, status])
  @@index([unidadeId])
  @@map("visitas")
}

/**
 * Credenciais da subconta do condomínio no provedor de cobrança.
 *
 * Uma subconta POR CONDOMÍNIO, no CNPJ dele: o dinheiro da taxa condominial
 * liquida na conta do condomínio, nunca na nossa. Passar a receita de
 * terceiros pelo nosso caixa seria custódia de fundos, que é outro negócio e
 * outra licença. É também o que desamarra o módulo da nossa própria PJ.
 *
 * `apiKeyCifrada` guarda a chave da subconta cifrada em repouso (AES-GCM,
 * chave-mestra em env): um dump do banco sozinho não move dinheiro de
 * ninguém. Nunca sai em log, resposta de API ou Sentry.
 */
model IntegracaoFinanceira {
  id             String   @id @default(uuid()) @db.Uuid
  condominioId   String   @unique @map("condominio_id") @db.Uuid
  provedor       String   @default("asaas")
  contaExternaId String   @map("conta_externa_id")
  apiKeyCifrada  String   @map("api_key_cifrada")
  /** Token que o provedor devolve no header do webhook, para autenticá-lo. */
  webhookSegredo String?  @map("webhook_segredo")
  ativo          Boolean  @default(true)
  criadoEm       DateTime @default(now()) @map("criado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@map("integracoes_financeiras")
}

model ConfigFinanceiro {
  id            String   @id @default(uuid()) @db.Uuid
  condominioId  String   @unique @map("condominio_id") @db.Uuid
  diaVencimento Int      @default(10) @map("dia_vencimento")
  /** Enquanto false, nada é gerado: a geração automática é opt-in explícito. */
  geracaoAutomatica Boolean @default(false) @map("geracao_automatica")
  reguaAtiva    Boolean  @default(true) @map("regua_ativa")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])

  @@map("config_financeiro")
}

/** Quanto cada unidade paga por mês (a fração ideal varia por unidade). */
/**
 * Quanto a unidade paga e quem é o responsável por pagar.
 *
 * O responsável mora AQUI e não em `Morador` de propósito: quem paga a taxa é
 * o proprietário, que muitas vezes não é quem mora (imóvel alugado) e pode
 * nunca abrir o app. Amarrar a cobrança ao morador deixaria a unidade alugada
 * sem como cobrar.
 *
 * Nome e CPF/CNPJ são exigência do provedor: o Asaas não cria cliente sem os
 * dois, e não emite boleto sem cliente. São dados pessoais de quem pode nem
 * ser usuário do produto: só o gestor lê, e a API nunca os devolve ao morador.
 */
model TaxaUnidade {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  unidadeId    String   @unique @map("unidade_id") @db.Uuid
  valorMensal  Decimal  @map("valor_mensal") @db.Decimal(12, 2)
  responsavelNome    String? @map("responsavel_nome")
  /** Só dígitos. Validado na borda: documento errado só falharia no dia 1. */
  responsavelCpfCnpj String? @map("responsavel_cpf_cnpj")
  /** Opcional: com ele o provedor manda o boleto por e-mail também. */
  responsavelEmail   String? @map("responsavel_email")
  /**
   * Id do cliente na subconta do provedor, guardado depois da primeira
   * criação. Sem ele, cada geração criaria um cliente novo: o Asaas permite
   * duplicata e a conta do condomínio encheria de cópias da mesma pessoa.
   */
  clienteExternoId   String? @map("cliente_externo_id")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])
  unidade    Unidade    @relation(fields: [unidadeId], references: [id])

  @@index([condominioId])
  @@map("taxas_unidade")
}

/**
 * A cobrança de uma unidade numa competência.
 *
 * `@@unique([unidadeId, competencia])` é a trava que impede cobrar a mesma
 * unidade duas vezes pelo mesmo mês, que é o erro caro deste módulo: um
 * worker que roda duas vezes, ou um deploy no meio da geração, cobraria em
 * duplicidade sem essa restrição.
 */
model Cobranca {
  id           String         @id @default(uuid()) @db.Uuid
  condominioId String         @map("condominio_id") @db.Uuid
  unidadeId    String         @map("unidade_id") @db.Uuid
  /** Sempre o dia 1 do mês (UTC), como em LeituraMedidor. */
  competencia  DateTime       @db.Date
  valor        Decimal        @db.Decimal(12, 2)
  vencimento   DateTime       @db.Date
  status       StatusCobranca @default(PENDENTE)
  provedorCobrancaId String?  @map("provedor_cobranca_id")
  linhaDigitavel String?      @map("linha_digitavel")
  urlBoleto      String?      @map("url_boleto")
  pixCopiaCola   String?      @map("pix_copia_cola")
  pagoEm       DateTime?      @map("pago_em")
  valorPago    Decimal?       @map("valor_pago") @db.Decimal(12, 2)
  criadoEm     DateTime       @default(now()) @map("criado_em")
  atualizadoEm DateTime       @updatedAt @map("atualizado_em")

  condominio   Condominio    @relation(fields: [condominioId], references: [id])
  unidade      Unidade       @relation(fields: [unidadeId], references: [id])
  notificacoes Notificacao[]
  extratoItens ExtratoItem[]

  @@unique([unidadeId, competencia])
  @@index([condominioId, status])
  @@index([condominioId, competencia])
  @@map("cobrancas")
}

/**
 * Log bruto do que o provedor mandou. Serve a duas coisas: idempotência (o
 * mesmo evento reentregue não processa de novo) e auditoria, porque quando
 * alguém disser "paguei e o sistema não baixou" a resposta tem que estar
 * gravada e não depender do log da aplicação.
 */
model EventoWebhookFinanceiro {
  id           String   @id @default(uuid()) @db.Uuid
  /** ID do evento no provedor: a chave de idempotência. */
  eventoId     String   @unique @map("evento_id")
  tipo         String
  payload      Json
  processadoEm DateTime?  @map("processado_em")
  erro         String?
  criadoEm     DateTime @default(now()) @map("criado_em")

  @@map("eventos_webhook_financeiro")
}

/**
 * Saída de dinheiro que o síndico registra para a prestação de contas.
 *
 * NÃO é contas a pagar: nada aqui agenda nem executa pagamento (território
 * de administradora, fora da nossa aposta). É o registro do que se espera
 * ver debitado no extrato, para a conciliação ter contra o que bater.
 */
model Despesa {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  descricao    String
  valor        Decimal  @db.Decimal(12, 2)
  // Dia em que o débito deve aparecer no extrato.
  data         DateTime @db.Date
  criadoPorUsuarioId String @map("criado_por_usuario_id") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em")

  condominio   Condominio    @relation(fields: [condominioId], references: [id])
  criadoPor    Usuario       @relation(fields: [criadoPorUsuarioId], references: [id])
  extratoItens ExtratoItem[]

  @@index([condominioId, data])
  @@map("despesas")
}

/**
 * Uma linha do extrato bancário importado (OFX).
 *
 * A conciliação é o par (item do extrato, cobrança paga OU despesa). Quem
 * fecha o par é o síndico aceitando uma sugestão; `conciliadoObs` guarda o
 * motivo em português ("compensado 2 dias depois: pagamento de sexta"),
 * porque prestação de contas é auditável e um match sem explicação vira a
 * mesma linha vermelha muda que o concorrente dele mostra hoje.
 */
model ExtratoItem {
  id           String   @id @default(uuid()) @db.Uuid
  condominioId String   @map("condominio_id") @db.Uuid
  // Id da transação no banco (FITID do OFX): é o dedupe de reimportação.
  fitid        String
  data         DateTime @db.Date
  // Positivo entra, negativo sai, como no extrato.
  valor        Decimal  @db.Decimal(12, 2)
  descricao    String
  cobrancaId   String?  @map("cobranca_id") @db.Uuid
  despesaId    String?  @map("despesa_id") @db.Uuid
  conciliadoEm DateTime? @map("conciliado_em")
  conciliadoObs String? @map("conciliado_obs")
  // Linha que não pertence à prestação (rendimento, estorno), com o porquê.
  ignoradoEm   DateTime? @map("ignorado_em")
  ignoradoObs  String?   @map("ignorado_obs")
  importadoEm  DateTime @default(now()) @map("importado_em")

  condominio Condominio @relation(fields: [condominioId], references: [id])
  cobranca   Cobranca?  @relation(fields: [cobrancaId], references: [id])
  despesa    Despesa?   @relation(fields: [despesaId], references: [id])

  @@unique([condominioId, fitid])
  @@index([condominioId, data])
  @@map("extrato_itens")
}

// Aviso direcionado (Via 1) OU ocorrência reportada pelo morador (Via 2).
model Aviso {
  id                 String      @id @default(uuid()) @db.Uuid
  condominioId       String      @map("condominio_id") @db.Uuid
  via                ViaAviso
  // Via 1: unidade destinatária. Via 2: unidade do morador autor.
  unidadeId          String      @map("unidade_id") @db.Uuid
  motivo             String
  descricao          String?
  fotoKey            String?     @map("foto_key")
  criadoPorUsuarioId String?     @map("criado_por_usuario_id") @db.Uuid
  criadoPorMoradorId String?     @map("criado_por_morador_id") @db.Uuid
  status             StatusAviso @default(ABERTO)
  criadoEm           DateTime    @default(now()) @map("criado_em")
  resolvidoEm        DateTime?   @map("resolvido_em")

  condominio       Condominio    @relation(fields: [condominioId], references: [id])
  unidade          Unidade       @relation(fields: [unidadeId], references: [id])
  criadoPorUsuario Usuario?      @relation("avisoCriadoPorUsuario", fields: [criadoPorUsuarioId], references: [id])
  criadoPorMorador Morador?      @relation("avisoCriadoPorMorador", fields: [criadoPorMoradorId], references: [id])
  notificacoes     Notificacao[]

  @@index([condominioId, via, status])
  @@index([unidadeId])
  @@map("avisos")
}
