DATABASE_URL="postgresql://pacotes:pacotes@localhost:5432/pacotes"
# Obrigatório em produção (a API não sobe sem ele). Gere um valor longo e aleatório.
JWT_SECRET="troque-em-producao"
PORT=3001
# DEV ONLY: ecoa o código OTP na resposta (nunca ligue em produção).
OTP_DEV_ECHO=1
# Produção: origens do painel web, separadas por vírgula. Sem isso, browsers são bloqueados.
# CORS_ORIGINS="https://painel.seudominio.com.br"

# SMS real (Twilio). Sem estas variáveis, o envio roda em stub (código só no log).
# TWILIO_ACCOUNT_SID="AC..."
# TWILIO_AUTH_TOKEN="..."
# TWILIO_FROM="+1..."   # número comprado/trial do Twilio

# OCR real (Google Vision). Sem a chave, roda em stub (sem sugestão automática).
# Obs.: nos dev/production builds o OCR roda NO aparelho (ML Kit), esta chave
# só serve de fallback para o Expo Go.
# GOOGLE_VISION_API_KEY="AIza..."

# Link de download do app, anexado ao SMS de convite (TestFlight/APK/loja).
# APP_DOWNLOAD_URL="https://..."

# FOTOS EM PRODUÇÃO (Cloudflare R2, S3-compatível). OBRIGATÓRIO no Render:
# o disco de lá é efêmero e todo comprovante de entrega some a cada deploy.
# Sem estas 4 variáveis, a API grava em disco local (ok só em dev).
# O bucket deve ficar PRIVADO: quem serve a foto é a API, com foto-token.
# R2_ACCOUNT_ID="..."          # Cloudflare dashboard → R2
# R2_BUCKET="convivar-fotos"
# R2_ACCESS_KEY_ID="..."       # R2 → Manage API Tokens
# R2_SECRET_ACCESS_KEY="..."

# BACKUP DO POSTGRES (cron job do Render, scripts/backup-db.ts).
# Role DEDICADA, criada por prisma/sql/backup-role.sql: as tabelas usam
# FORCE RLS e o pg_dump falha com a role comum. Não use a role da API com
# BYPASSRLS, porque isso desliga o isolamento entre condomínios em produção.
# BACKUP_DATABASE_URL="postgresql://backup_ro:SENHA@host:5432/banco"
# BACKUP_RETENCAO_DIAS=30

# WHATSAPP (alcança quem não instalou o app).
#
# Reaproveita a conta Twilio do SMS: só o número/remetente é outro. Sem
# TWILIO_WHATSAPP_FROM o canal roda em STUB (loga em vez de enviar).
#
# GATE: mensagem iniciada pela empresa exige WABA verificada no Meta Business
# (pede CNPJ) e TEMPLATE aprovado por tipo de mensagem. O sandbox do Twilio
# permite exercitar o código antes disso.
# TWILIO_WHATSAPP_FROM="+14155238886"       # sandbox do Twilio, ou o número da WABA
# WHATSAPP_TEMPLATE_COMUNICADO="HX..."      # ContentSid do template aprovado
# WHATSAPP_TEMPLATE_COBRANCA="HX..."
#
# Sem template configurado o envio é pulado em vez de virar texto livre, que
# o Meta recusaria. Três portas independentes governam cada envio: o módulo
# `whatsapp` ligado no condomínio, o opt-in do morador (ele liga no app) e o
# tipo do aviso. Encomenda nunca vai por aqui: é o motor de adoção do app.

# COBRANÇA DA TAXA CONDOMINIAL (módulo financeiro).
#
# Sem ASAAS_API_URL o provedor roda em STUB: as cobranças são registradas e a
# régua funciona, mas NENHUM boleto é emitido de verdade. O painel avisa isso
# em vermelho. Use a sandbox para testar antes de apontar para produção:
# ASAAS_API_URL="https://api-sandbox.asaas.com/v3"   # produção: https://api.asaas.com/v3
#
# Chave-mestra que cifra (AES-256-GCM) as credenciais das subcontas guardadas
# no banco. Obrigatória para ligar a integração de qualquer condomínio: sem
# ela a API recusa gravar a chave em vez de guardá-la em claro. Trocar esta
# variável torna ilegíveis as credenciais já gravadas, e cada condomínio
# precisa reconfigurar a integração.
# FINANCEIRO_CRIPTO_CHAVE="frase-longa-e-aleatoria-so-desta-instalacao"
#
# A chave de API de CADA condomínio não vem por env: é da subconta dele (no
# CNPJ dele) e o síndico a informa no painel, em Financeiro. O dinheiro
# liquida na conta do condomínio, nunca na nossa.

# OBSERVABILIDADE (Sentry). Sem SENTRY_DSN nada é inicializado.
# O foto-token (?t=...) é removido de URLs, contextos e breadcrumbs antes do
# envio: ver src/instrument.ts.
# SENTRY_DSN="https://...@....ingest.sentry.io/..."
# SENTRY_TRACES_SAMPLE_RATE=0.05   # opcional; o plano free queima rápido em 1.0

# CONTAS DE DEMO PARA O REVIEW DAS LOJAS (produção).
# O login é OTP por SMS e o revisor da Apple não tem o nosso chip: estes
# telefones aceitam um código FIXO e não disparam SMS. Informe o par
# telefone/código nas notas de review (App Store Connect e Play Console).
# Liste um número de portaria e um de morador: o app roteia por papel e o
# revisor precisa ver as duas experiências.
# As contas precisam existir no banco (semeie com prisma/seed-demo.ts).
# Deixe AMBAS em branco para desativar o desvio.
# DEMO_TELEFONES="5551900000002,5551900000003"
# DEMO_CODIGO="314159"

# ----- E-mail (redefinição de senha do painel) -----
# O gestor entra no painel por senha, e o único caminho de volta é o link que
# chega por e-mail. Sem estas duas, o serviço roda em stub: o link sai no log
# em vez de ir para a caixa de entrada, o que serve para desenvolvimento e
# NÃO serve para um síndico de verdade.
#
# Resend por HTTP (e não SMTP: o Render bloqueia a porta 587 de saída).
# O remetente precisa de domínio verificado com SPF/DKIM no provedor; até lá
# a conta de teste do Resend só entrega para o e-mail do próprio dono.
# RESEND_API_KEY="re_..."
# EMAIL_REMETENTE="Convivar <nao-responda@seudominio.com.br>"

# Base do link de redefinição. Sem ela o link aponta para o painel local, o
# que quebra em produção de um jeito silencioso: o e-mail chega, e o link
# não abre nada.
# PAINEL_URL="https://painel.seudominio.com.br"

# Devolve o link de redefinição NA RESPOSTA da API, para desenvolvimento e
# para a suíte E2E. Opt-in explícito, como o OTP_DEV_ECHO: em produção isto
# permitiria pedir a redefinição de qualquer gestor e ler o link na hora.
EMAIL_DEV_ECHO=1
