{
  "name": "pacotes",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "typecheck": "pnpm --filter @pacotes/shared build && pnpm -r typecheck",
    "dev:api": "pnpm --filter @pacotes/api start:dev",
    "db:migrate": "pnpm --filter @pacotes/api prisma:migrate",
    "db:rls": "pnpm --filter @pacotes/api prisma:rls",
    "db:seed": "pnpm --filter @pacotes/api prisma:seed",
    "db:seed-demo": "pnpm --filter @pacotes/api prisma:seed-demo"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
