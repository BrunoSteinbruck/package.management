{
  "name": "pacotes",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev:api": "pnpm --filter @pacotes/api start:dev",
    "db:migrate": "pnpm --filter @pacotes/api prisma:migrate",
    "db:rls": "pnpm --filter @pacotes/api prisma:rls",
    "db:seed": "pnpm --filter @pacotes/api prisma:seed"
  }
}
